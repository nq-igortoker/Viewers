# OHIF Viewer - Environment Variables Template
# 
# Kopieren Sie diese Datei zu .env.local für lokale Entwicklung:
#   cp .env.example .env.local
#
# Wichtig: .env.local wird NICHT ins Git committed!

# =============================================================================
# CreateReport Integration
# =============================================================================

# URL der CreateReport Instanz
# Standard: http://localhost:3001
# Vercel: https://your-createreport-instance.vercel.app
CREATE_REPORT_BASE_URL=http://localhost:3001

# API Key für CreateReport (optional, für zukünftige Features)
# Lassen Sie dies leer wenn nicht benötigt
CREATE_REPORT_API_KEY=

# =============================================================================
# OHIF Development Server (nur lokal, nicht für Vercel)
# =============================================================================

# Port für den Development Server
# Standard: 3000
# OHIF_PORT=3000

# Browser automatisch öffnen beim Start
# Standard: true
# OHIF_OPEN=true

# =============================================================================
# Zukünftige Variables (Geplant)
# =============================================================================

# Wartungsmodus (Issue #34 - in Planung)
# MAINTENANCE_MODE=false


# =============================================================================
# Notizen
# =============================================================================
#
# Build-Time vs Runtime:
# - CREATE_REPORT_* Variables sind Build-Time (Vercel: Redeploy erforderlich)
# - OHIF_* Variables sind Runtime (nur Dev-Server, sofort wirksam)
#
# Mehr Infos: ENV_VARIABLES.md
