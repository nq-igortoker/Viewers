{
  "version": 2,
  "buildCommand": "cd platform/app && cross-env NODE_ENV=production APP_CONFIG=config/hetzner.js PUBLIC_URL=/ yarn build",
  "outputDirectory": "platform/app/dist",
  "framework": null,
  "installCommand": "yarn install:frozen",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
